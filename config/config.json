{
  "format": "webjammin-config",
  "version": 1,

  "audio": {
    "device": "plughw:CARD=ES8389Audio,DEV=0",
    "sample_rate": 48000,
    "period_frames": 256,
    "music_volume": 0.85,
    "sfx_volume": 1.0
  },

  "timing": {
    "perfect_ms": 25,
    "great_ms": 55,
    "good_ms": 90,
    "offset_ms": 0
  },

  "gameplay": {
    "scroll_speed": 220,
    "no_fail": false,
    "hopo_supported": true,
    "strum_required": false,
    "overstrum_penalty": true,
    "lead_in_ms": 1500,
    "play_mode": "classic"
  },

  "catalogue": {
    "enabled": true,
    "index_url": "",
    "download_dir": "~/webjammin/songs"
  },

  "gpio": {
    "enabled": true,
    "active_low": true,
    "debounce_ms": 5,
    "pins": [
      { "bcm": 22, "label": "fret1", "lane": 0 },
      { "bcm": 11, "label": "fret2", "lane": 1 },
      { "bcm": 10, "label": "fret3", "lane": 2 },
      { "bcm": 9,  "label": "fret4", "lane": 3 },
      { "bcm": 7,  "label": "fret5", "lane": 4 },
      { "bcm": 15, "label": "strum", "strum": true }
    ]
  },

  "songs": {
    "directories": [
      "~/webjammin/songs",
      "/opt/webjammin/songs",
      "songs"
    ]
  },

  "paths": {
    "scores": "~/.local/share/webjammin/scores.json",
    "cache": "~/.cache/webjammin/songcache.json"
  },

